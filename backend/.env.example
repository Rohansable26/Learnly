# ============================================================
#  Learnly Backend — Environment Configuration
# ============================================================

# --- Groq Cloud (Primary & Dedicated AI — ultra-fast LPU inference) ---
# Sign up free at: https://console.groq.com/
# Model: openai/gpt-oss-120b | llama-3.3-70b-versatile | llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- YouTube Data API v3 (Optional) ---
# Setup: https://console.cloud.google.com/ -> Enable "YouTube Data API v3" -> Create API Key
# Note: Falls back automatically to DuckDuckGo video search if not set.
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=6

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=True
